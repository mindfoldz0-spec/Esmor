# Where the app sends its push token so a server can push to this device.
# Use the network address (not localhost) when testing on a physical device.
# EXPO_PUBLIC_NOTIFICATION_SERVER_URL=http://192.168.1.10:8787

# Fallback EAS project id. Normally this lives in app.json under
# extra.eas.projectId, which `eas init` adds for you.
# EXPO_PUBLIC_EAS_PROJECT_ID=

# Access token for the Expo Push Service, used by the scripts in scripts/.
# EXPO_ACCESS_TOKEN=

# Port for the local notification server.
# PUSH_SERVER_PORT=8787
